# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Claude (console.anthropic.com). Without it, generation falls back to template copy
# and prompt edits are disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Agent sites are served at <slug>.ROOT_DOMAIN. Locally use lvh.me (resolves to 127.0.0.1):
# http://jane-doe.lvh.me:3000  — or just visit http://localhost:3000/s/jane-doe
NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Who can open /admin (AI usage dashboard and limits). Comma-separated emails.
ADMIN_EMAILS=you@example.com

# Optional: retry agent sites that block cloud servers through ScrapingBee (scrapingbee.com).
SCRAPINGBEE_API_KEY=
